{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.tashwinfurniture.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://api.tashwinfurniture.com/uploads/:path*" },
    { "source": "/sitemap.xml", "destination": "https://api.tashwinfurniture.com/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://api.tashwinfurniture.com/robots.txt" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
