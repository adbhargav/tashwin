# Postgres — paste the Neon connection string here
DATABASE_URL=postgres://localhost:5432/tashwin
PORT=4000
CLIENT_ORIGIN=http://localhost:5180

# Firebase project id (Project settings > General). Leave empty to use the local dev login.
FIREBASE_PROJECT_ID=
# Firebase web API key (same as VITE_FIREBASE_API_KEY). Lets the admin panel create dealer accounts and send password resets.
FIREBASE_API_KEY=
# Service account JSON (Project settings > Service accounts > Generate new private key), pasted on one line or base64.
# With it, password-reset emails are sent from EMAIL_USER instead of Firebase's noreply address, which often lands in spam.
FIREBASE_SERVICE_ACCOUNT=
# Comma-separated emails that become admins when they sign in
ADMIN_EMAILS=admin@tashwin.test
# Admin panel (/admin) password sign-in. `npm run seed:admin` saves ADMIN_PASSWORD (hashed) in the database
# for every ADMIN_EMAILS address; change it here and re-run to reset it.
# ADMIN_JWT_SECRET signs admin sessions and must be at least 32 characters; leave it empty to disable the login.
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Razorpay keys (Dashboard > API Keys). Leave empty locally to use mock payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks: URL https://<your-api-domain>/api/webhooks/razorpay, events payment.captured and order.paid
RAZORPAY_WEBHOOK_SECRET=

# Gmail address + app password used to send customer and admin emails. Leave empty to disable email.
EMAIL_USER=
EMAIL_PASS=
# Unpaid orders older than this get a "complete your order" email
INCOMPLETE_ORDER_MINUTES=30

# Cloudflare R2 (S3-compatible) for uploaded images and videos. R2 > Manage API tokens gives the endpoint and keys.
# R2_PUBLIC_URL is the bucket's public URL (r2.dev or custom domain); leave it empty to serve files through this server.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Set to production on the live server (turns off the local dev login and mock payments).
NODE_ENV=
